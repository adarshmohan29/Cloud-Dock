# AWS configuration
AWS_ACCESS_KEY="paste your AWS access key here"
AWS_SECRET_KEY="paste your AWS secret key here"
AWS_REGION="paste your AWS region here"
EC2_AMI_ID="paste your EC2 AMI ID here"
EC2_INSTANCE_TYPE=t2.micro
EC2_SECURITY_GROUP_ID="paste your security group ID here"

# GitHub API and OAuth configuration
GITHUB_TOKEN="paste your GitHub token here"
GITHUB_CLIENT_ID="paste your GitHub OAuth client ID here"
CLIENT_SECRET="paste your GitHub OAuth client secret here"
CALLBACK_URL=http://localhost:3000/auth/github/callback
